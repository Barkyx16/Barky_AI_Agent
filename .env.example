# Your Anthropic API key. Leave empty to run Boardroom in demo mode (scripted board, no API calls).
ANTHROPIC_API_KEY=

# Optional settings
# BOARDROOM_MODEL=claude-opus-5-5
# BOARDROOM_DB_PATH=data/boardroom.db
