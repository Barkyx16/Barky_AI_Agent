# Your Anthropic API key. Leave empty to run Boardroom in demo mode (scripted board, no API calls).
ANTHROPIC_API_KEY=

# Optional settings
# BOARDROOM_MODEL=claude-opus-5-5
# BOARDROOM_DB_PATH=data/boardroom.db
# BOARDROOM_WEB_SEARCH=1            # let the Analyst search the web for facts
# BOARDROOM_FREE_DAILY_LIMIT=3      # sessions per day on the free plan
# BOARDROOM_SECURE_COOKIES=0        # set to 1 behind HTTPS
# BOARDROOM_DEMO=0                  # set to 1 to force demo mode even with a key

# Stripe billing (optional). Create a recurring Price in Stripe and a webhook endpoint
# pointing at https://YOUR-DOMAIN/api/billing/webhook with events:
#   checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BOARDROOM_PUBLIC_URL=https://your-domain.com
# BOARDROOM_PRO_PRICE_LABEL=$12/month
